FROM node:20-alpine AS base
WORKDIR /app

FROM base AS development
COPY user ./user
COPY libs ./libs
RUN cd ./user && npm install
RUN cd ./libs/eureka && npm install
RUN cd ./libs/firebase && npm install
CMD ["cd", "user", "&&", "npm", "run", "start:dev"]

FROM base AS production
RUN npm install --omit=dev
COPY user .
COPY libs/eureka ./libs/eureka
RUN cd ./libs/eureka && npm install
RUN cd ./libs/firebase && npm install
RUN npm run build
CMD ["node", "dist/main.js"]
