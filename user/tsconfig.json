{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "watchOptions": {
    "watchFile": "fixedPollingInterval"
  },
  "references": [
    { "path": "../libs/common" },
    { "path": "../libs/firebase" },
    { "path": "../libs/redis" },
    { "path": "../libs/rmq" },
    { "path": "../libs/health" }
  ]
}
