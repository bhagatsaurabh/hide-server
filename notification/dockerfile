FROM node:20-alpine AS base
RUN apk add jq
WORKDIR /app

FROM base AS development
COPY notification ./notification
COPY libs ./libs
RUN cd ./notification && npm ci
RUN for dir in $(jq ".references[].path" ./notification/tsconfig.json); do \
  (cd "${dir:2:-1}" && npm ci); \
  done
CMD ["cd", "notification", "&&", "npm", "run", "start:dev"]

FROM base AS production
RUN npm ci --omit=dev
COPY notification ./notification
COPY libs ./libs
RUN for dir in $(jq ".references[].path" ./notification/tsconfig.json); do \
  (cd "${dir:2:-1}" && npm ci); \
  done
RUN cd ./notification && npm run build
CMD ["node", "dist/main.js"]
